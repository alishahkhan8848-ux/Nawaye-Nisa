# Copy this file to .env and fill in the values from your own Firebase project:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration.
#
# You need a real Firebase project with these enabled:
#   1. Authentication -> Sign-in method -> Email/Password (enabled)
#   2. Firestore Database (created, in production or test mode)
#   3. Storage (created)
#
# Vite only exposes env vars prefixed with VITE_ to the client bundle.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
